default_platform(:ios)

APP_ID = "com.maxsroka.linemap"

platform :ios do
  desc "Build with cloud-managed signing and upload to TestFlight (runs in GitHub Actions)"
  lane :beta do
    setup_ci # temporary keychain for the signing certificate Xcode fetches

    key_path = ENV.fetch("ASC_KEY_PATH")
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")
    team_id = ENV.fetch("APPLE_TEAM_ID")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_ID,
      initial_build_number: 0
    ) + 1

    # Lets xcodebuild create and download signing assets with the API key.
    # Cloud-managed signing needs an API key with the Admin role.
    auth = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{key_path}",
      "-authenticationKeyID #{key_id}",
      "-authenticationKeyIssuerID #{issuer_id}"
    ].join(" ")

    build_app(
      project: "LineMap.xcodeproj",
      scheme: "LineMap",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: team_id,
      export_options: { signingStyle: "automatic", teamID: team_id },
      xcargs: "#{auth} DEVELOPMENT_TEAM=#{team_id} CURRENT_PROJECT_VERSION=#{build_number}",
      export_xcargs: auth,
      output_directory: "build",
      output_name: "LineMap.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
