default_platform(:ios)

APP_ID = "io.github.bigmanmike7.linemapapp"

platform :ios do
  desc "Build with cloud-managed signing and upload to TestFlight (runs in GitHub Actions)"
  lane :beta do
    setup_ci # temporary keychain for the signing certificate Xcode fetches

    # Fail fast on a missing or blank secret instead of a confusing signing error later.
    required = %w[ASC_KEY_PATH ASC_KEY_ID ASC_ISSUER_ID APPLE_TEAM_ID]
    blank = required.select { |name| ENV[name].to_s.strip.empty? }
    UI.user_error!("Missing or empty: #{blank.join(', ')}") unless blank.empty?

    key_path = ENV["ASC_KEY_PATH"]
    key_id = ENV["ASC_KEY_ID"]
    issuer_id = ENV["ASC_ISSUER_ID"]
    team_id = ENV["APPLE_TEAM_ID"].strip
    UI.user_error!("APPLE_TEAM_ID is set to the API key ID") if team_id == key_id.strip

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_ID,
      initial_build_number: 0
    ) + 1

    # Lets xcodebuild create and download signing assets with the API key.
    # Cloud-managed signing needs an API key with the Admin role.
    # The archive is built unsigned and signed only at export: automatic
    # signing would otherwise archive with a development profile, which
    # needs a registered device. App Store signing needs none.
    auth = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{key_path}",
      "-authenticationKeyID #{key_id}",
      "-authenticationKeyIssuerID #{issuer_id}"
    ].join(" ")

    build_app(
      project: "LineMap.xcodeproj",
      scheme: "LineMap",
      configuration: "Release",
      export_method: "app-store",
      export_team_id: team_id,
      export_options: { signingStyle: "automatic", teamID: team_id },
      xcargs: "CODE_SIGNING_ALLOWED=NO DEVELOPMENT_TEAM=#{team_id} CURRENT_PROJECT_VERSION=#{build_number}",
      export_xcargs: auth,
      output_directory: "build",
      output_name: "LineMap.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
